# =============================================================================
# Journal Capture - Optional local development configuration
# =============================================================================
# Docker / production: configure everything in docker-compose.yml instead.
# You do not need a .env file for Docker Compose deployments.
#
# Local development (python app.py): copy this file to .env if you want the
# app to load settings from disk without exporting variables in your shell.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file (it is already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
JOURNAL_SECRET_KEY=change-me-to-a-long-random-string
JOURNAL_HOST=0.0.0.0
JOURNAL_PORT=5000
JOURNAL_DEBUG=false

# -----------------------------------------------------------------------------
# Data Storage Paths
# -----------------------------------------------------------------------------
JOURNAL_DATA_DIR=./data
JOURNAL_JOURNALS_DIR=./data/journals
JOURNAL_THUMBS_DIR=./data/.thumbnails
JOURNAL_BACKUP_CONFIG_PATH=./instance/backup_config.yml
JOURNAL_MAX_UPLOAD_MB=256

# -----------------------------------------------------------------------------
# Transcribe & Translate (OpenRouter) Add-in
# -----------------------------------------------------------------------------
TRANSCRIBE_TRANSLATE_ENABLED=true
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_OCR_MODEL=google/gemini-3-flash-preview
OPENROUTER_TRANSLATION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_REASONING_MAX_TOKENS=2000
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
OPENROUTER_APP_NAME=Journal Capture
OPENROUTER_SITE_URL=http://localhost:5000
