# =============================================================================
# Journal Capture - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
#
# For Docker deployments (recommended for production):
#   cp .env.example .env
#   # then edit .env with your real values
#
# For local development:
#   The app will automatically load this file if .env exists in the project root.
#
# IMPORTANT: Never commit your actual .env file (it is already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
# Secret key for Flask sessions and security. Use a long random string in production.
JOURNAL_SECRET_KEY=change-me-to-a-long-random-string

# Host and port
JOURNAL_HOST=0.0.0.0
JOURNAL_PORT=5000

# Debug mode (set to true only for local development)
JOURNAL_DEBUG=false

# -----------------------------------------------------------------------------
# Data Storage Paths
# -----------------------------------------------------------------------------
# Base data directory (Docker users should usually override this via volumes)
JOURNAL_DATA_DIR=/data

# Specific directories (usually left as defaults unless you have special needs)
JOURNAL_JOURNALS_DIR=/data/journals
JOURNAL_THUMBS_DIR=/data/.thumbnails
JOURNAL_BACKUP_CONFIG_PATH=/data/config/backup_config.yml

# Maximum upload size in MB (default 256MB is generous for journal scans)
JOURNAL_MAX_UPLOAD_MB=256

# -----------------------------------------------------------------------------
# Transcribe & Translate (OpenRouter) Add-in
# -----------------------------------------------------------------------------
# Enable the AI transcription feature
TRANSCRIBE_TRANSLATE_ENABLED=true

# Your OpenRouter API key (required for the feature)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OCR Model - used for the first pass (verbatim transcription)
# Recommended: google/gemini-3-flash-preview or similar fast vision model
OPENROUTER_OCR_MODEL=google/gemini-3-flash-preview

# Translation / Enrichment Model - used for the second pass
# Recommended: google/gemini-3.1-flash-lite or a stronger model if you want better translations
OPENROUTER_TRANSLATION_MODEL=google/gemini-3.1-flash-lite

# Optional: Legacy single model variable (still supported as fallback for OCR)
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# Optional: Enable reasoning on the translation step (increases quality but costs more)
OPENROUTER_REASONING_MAX_TOKENS=2000

# Optional: Maximum tokens for the OCR step
OPENROUTER_OCR_MAX_TOKENS=4000

# Optional: Image adjustment model (de-skew/crop). Leave empty to disable.
# Example: google/gemini-3.1-flash-image-preview
OPENROUTER_IMAGE_MODEL=

# Optional metadata sent to OpenRouter
OPENROUTER_APP_NAME=Journal Capture
OPENROUTER_SITE_URL=http://localhost:5000
